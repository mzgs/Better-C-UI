include(CMakeFindDependencyMacro)
@CUI_CONFIG_DEPS@include("${CMAKE_CURRENT_LIST_DIR}/cuiTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/CuiApp.cmake")
foreach(component IN LISTS cui_FIND_COMPONENTS)
    if(component STREQUAL "webview" AND @CUI_WEBVIEW@ AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/cuiWebviewTargets.cmake")
        set(cui_webview_FOUND TRUE)
        if("@CUI_BACKEND@" STREQUAL "x11" AND NOT TARGET PkgConfig::CUI_WEBKIT)
            find_package(PkgConfig QUIET)
            if(PkgConfig_FOUND)
                pkg_check_modules(CUI_WEBKIT QUIET IMPORTED_TARGET webkit2gtk-4.1)
            endif()
            if(NOT TARGET PkgConfig::CUI_WEBKIT)
                set(cui_webview_FOUND FALSE)
            endif()
        endif()
        if(cui_webview_FOUND)
            include("${CMAKE_CURRENT_LIST_DIR}/cuiWebviewTargets.cmake")
        endif()
    elseif(component STREQUAL "video" AND @CUI_VIDEO@ AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/cuiVideoTargets.cmake")
        set(_cui_module_path "${CMAKE_MODULE_PATH}")
        list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
        find_package(MPV QUIET MODULE)
        set(CMAKE_MODULE_PATH "${_cui_module_path}")
        unset(_cui_module_path)
        set(cui_video_FOUND ${MPV_FOUND})
        if(cui_video_FOUND)
            include("${CMAKE_CURRENT_LIST_DIR}/cuiVideoTargets.cmake")
        endif()
    elseif(component STREQUAL "tree_sitter" AND @CUI_TREE_SITTER@ AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/cuiTreeSitterTargets.cmake")
        set(_cui_module_path "${CMAKE_MODULE_PATH}")
        list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
        find_package(TreeSitter QUIET MODULE)
        set(CMAKE_MODULE_PATH "${_cui_module_path}")
        unset(_cui_module_path)
        set(cui_tree_sitter_FOUND ${TreeSitter_FOUND})
        if(cui_tree_sitter_FOUND)
            include("${CMAKE_CURRENT_LIST_DIR}/cuiTreeSitterTargets.cmake")
        endif()
    else()
        set(cui_${component}_FOUND FALSE)
    endif()
    if(NOT cui_${component}_FOUND AND cui_FIND_REQUIRED_${component})
        set(cui_FOUND FALSE)
        if(component STREQUAL "video")
            set(cui_NOT_FOUND_MESSAGE "CUI component 'video' or libmpv is unavailable; build with CUI_VIDEO=ON for video playback")
        elseif(component STREQUAL "tree_sitter")
            set(cui_NOT_FOUND_MESSAGE "CUI component 'tree_sitter' or its runtime is unavailable; build with CUI_TREE_SITTER=ON for the Tree-sitter add-on")
        else()
            set(cui_NOT_FOUND_MESSAGE "CUI component '${component}' or its browser SDK is unavailable; build with CUI_WEBVIEW=ON for the WebView add-on")
        endif()
    endif()
endforeach()
