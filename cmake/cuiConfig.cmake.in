include(CMakeFindDependencyMacro)
@CUI_CONFIG_DEPS@include("${CMAKE_CURRENT_LIST_DIR}/cuiTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/CuiApp.cmake")
foreach(component IN LISTS cui_FIND_COMPONENTS)
    if(component STREQUAL "webview" AND @CUI_WEBVIEW@ AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/cuiWebviewTargets.cmake")
        set(cui_webview_FOUND TRUE)
        if("@CUI_BACKEND@" STREQUAL "x11" AND NOT TARGET PkgConfig::CUI_WEBKIT)
            find_package(PkgConfig QUIET)
            if(PkgConfig_FOUND)
                pkg_check_modules(CUI_WEBKIT QUIET IMPORTED_TARGET webkit2gtk-4.1)
            endif()
            if(NOT TARGET PkgConfig::CUI_WEBKIT)
                set(cui_webview_FOUND FALSE)
            endif()
        endif()
        if(cui_webview_FOUND)
            include("${CMAKE_CURRENT_LIST_DIR}/cuiWebviewTargets.cmake")
        endif()
    else()
        set(cui_${component}_FOUND FALSE)
    endif()
    if(NOT cui_${component}_FOUND AND cui_FIND_REQUIRED_${component})
        set(cui_FOUND FALSE)
        set(cui_NOT_FOUND_MESSAGE "CUI component '${component}' or its browser SDK is unavailable; build with CUI_WEBVIEW=ON for the WebView add-on")
    endif()
endforeach()
