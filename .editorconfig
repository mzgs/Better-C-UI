# Editor settings that match the code (see docs/CONTRIBUTING.md, Code style)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h,m,cpp}]
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json,py,js,mjs,css,html,cmake,txt}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab
